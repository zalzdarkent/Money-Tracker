# ==========================================
# MONEY TRACKER - ENVIRONMENT CONFIG
# (Direct Gemini AI + Google Sheets Apps Script)
# ==========================================

# 1. Gemini API Key (Dapatkan di https://aistudio.google.com/app/apikey)
VITE_GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# 2. Gemini Model (opsional, default: gemini-3.6-flash)
VITE_GEMINI_MODEL="gemini-3.6-flash"

# 3. Google Sheets Spreadsheet ID (database & dashboard)
# URL: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
VITE_GOOGLE_SHEETS_ID="19_WEy7mMHbzderOH5kkiu0ChFnuj_0RG6noKqAJk_Q4"

# 4. Google Apps Script Web App URL (untuk auto-insert data pengeluaran)
# Dibuat via Google Sheets > Ekstensi > Apps Script > Deploy > Web app (Anyone)
VITE_GOOGLE_SCRIPT_URL="https://script.google.com/macros/s/AKfycb.../exec"
