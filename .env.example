# ==========================================
# AI PERSONAL EXPENSE TRACKER - ENVIRONMENT CONFIG
# ==========================================

# ------------------------------------------
# 1. FRONTEND CONFIGURATION (Vite + React)
# ------------------------------------------
# URL Webhook dari frontend akan dikirim ke proxy Vite agar tidak kena CORS.
# Browser akan memanggil /webhook/catat-keuangan, lalu Vite meneruskannya ke n8n.
# URL asli n8n: http://localhost:5678/webhook/catat-keuangan
VITE_N8N_WEBHOOK_URL="/webhook/catat-keuangan"

# Opsional: endpoint GET n8n yang membaca Google Sheets dan mengembalikan total bulan berjalan.
# Response yang didukung frontend: { "monthly_velocity": 123000 } atau { "total_nominal": 123000 }
VITE_N8N_MONTHLY_SUMMARY_URL="/webhook/monthly-velocity"

# AI Studio App Hosting URL
APP_URL="http://localhost:3000"

# Gemini API Key untuk FRONTEND (Gemini Vision - scan foto struk)
# Dapatkan di: https://aistudio.google.com/app/apikey
# Key yang sama dengan GEMINI_API_KEY bisa dipakai di sini.
VITE_GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# Untuk jalankan n8n dari terminal, pakai:
# N8N_CORS_ENABLED=true npx n8n start

# ------------------------------------------
# 2. BACKEND & N8N AUTOMATION CREDENTIALS
# (Simpan & gunakan di environment n8n / credential store)
# ------------------------------------------
# Google Gemini API Key (didapatkan dari Google AI Studio: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# ID Spreadsheet Google Sheets yang dijadikan database
# Contoh URL: https://docs.google.com/spreadsheets/d/1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms/edit
# ID adalah string panjang di antara /d/ dan /edit:
GOOGLE_SHEETS_ID="1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms"

# Email Google Cloud Service Account yang telah diberi akses "Editor" ke Google Sheets di atas
GOOGLE_SERVICE_ACCOUNT_EMAIL="expense-tracker-bot@your-gcp-project.iam.gserviceaccount.com"

# Private Key dari Service Account JSON Google Cloud (dengan format \n atau multiline)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQD3X...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------
# 3. N8N ENVIRONMENT VARIABLES (Optional jika run via docker/npm)
# ------------------------------------------
# N8N_PORT=5678
# N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
# WEBHOOK_URL=http://localhost:5678/
# N8N_CORS_ENABLED=true
